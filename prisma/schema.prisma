datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum StaffRole {
  ADMIN
  DISPATCHER
  TECHNICIAN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALLING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model StaffProfile {
  id        String       @id @default(uuid())
  userId    String       @unique
  email     String       @unique
  fullName  String
  phone     String?
  role      StaffRole    @default(DISPATCHER)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  jobs      Job[]        @relation("AssignedTechnician")
  audits    AuditEvent[]

  @@map("staff_profiles")
}

model Customer {
  id                      String           @id @default(uuid())
  email                   String           @unique
  fullName                String
  phone                   String
  stripeCustomerId        String?          @unique
  passwordHash            String?
  portalResetToken        String?
  portalResetTokenExpiry  DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  addresses               ServiceAddress[]
  quotes                  Quote[]
  orders                  Order[]
  subscriptions           Subscription[]

  @@map("customers")
}

model ServiceAddress {
  id           String               @id @default(uuid())
  customerId   String
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street       String
  city         String
  state        String
  zip          String
  sqFt         Int?
  propertyType String
  accessNotes  String?
  createdAt    DateTime             @default(now())
  orders       Order[]
  requests     AppointmentRequest[]

  @@map("service_addresses")
}

model ServiceArea {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  active    Boolean         @default(true)
  prices    AreaPlanPrice[]

  @@map("service_areas")
}

model Plan {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String
  prices      AreaPlanPrice[]
  quotes      Quote[]
  orders      Order[]

  @@map("plans")
}

model AreaPlanPrice {
  id              String      @id @default(uuid())
  serviceAreaId   String
  serviceArea     ServiceArea @relation(fields: [serviceAreaId], references: [id])
  planId          String
  plan            Plan        @relation(fields: [planId], references: [id])
  basePriceCents  Int
  initialFeeCents Int         @default(0)
  stripePriceId   String?

  @@unique([serviceAreaId, planId])
  @@map("area_plan_prices")
}

model Quote {
  id              String    @id @default(uuid())
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id])
  zipCode         String
  sqFt            Int
  monthlyCents    Int
  initialFeeCents Int
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  orders          Order[]

  @@map("quotes")
}

model Order {
  id            String               @id @default(uuid())
  referenceCode String               @unique
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  addressId     String
  address       ServiceAddress       @relation(fields: [addressId], references: [id])
  quoteId       String?
  quote         Quote?               @relation(fields: [quoteId], references: [id])
  planId        String
  plan          Plan                 @relation(fields: [planId], references: [id])
  status        OrderStatus          @default(PENDING_PAYMENT)
  totalCents    Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  payments      Payment[]
  subscriptions Subscription[]
  requests      AppointmentRequest[]
  jobs          Job[]

  @@map("orders")
}

model Payment {
  id                      String        @id @default(uuid())
  orderId                 String
  order                   Order         @relation(fields: [orderId], references: [id])
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  amountCents             Int
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())

  @@map("payments")
}

model Subscription {
  id                   String             @id @default(uuid())
  customerId           String
  customer             Customer           @relation(fields: [customerId], references: [id])
  orderId              String
  order                Order              @relation(fields: [orderId], references: [id])
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())

  @@map("subscriptions")
}

model AppointmentRequest {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  addressId     String
  address       ServiceAddress @relation(fields: [addressId], references: [id])
  preferredDate DateTime
  arrivalWindow String
  alternateDate DateTime?
  notes         String?
  confirmed     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  job           Job?

  @@map("appointment_requests")
}

model Job {
  id             String             @id @default(uuid())
  orderId        String
  order          Order              @relation(fields: [orderId], references: [id])
  requestId      String             @unique
  request        AppointmentRequest @relation(fields: [requestId], references: [id])
  technicianId   String?
  technician     StaffProfile?      @relation("AssignedTechnician", fields: [technicianId], references: [id])
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         String             @default("ASSIGNED")
  serviceNotes   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  calendarSyncs  CalendarEventSync[]

  @@map("jobs")
}

model CalendarConnection {
  id           String              @id @default(uuid())
  provider     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  syncs        CalendarEventSync[]

  @@map("calendar_connections")
}

model CalendarEventSync {
  id              String             @id @default(uuid())
  jobId           String
  job             Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      CalendarConnection @relation(fields: [connectionId], references: [id])
  externalEventId String?
  status          SyncStatus         @default(PENDING)
  lastSyncedAt    DateTime           @default(now())

  @@map("calendar_event_syncs")
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  eventType String
  processed Boolean  @default(false)
  payload   Json
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

model AuditEvent {
  id        String        @id @default(uuid())
  staffId   String?
  staff     StaffProfile? @relation(fields: [staffId], references: [id])
  action    String
  resource  String
  metadata  Json?
  createdAt DateTime      @default(now())

  @@map("audit_events")
}
